{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": false,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["main.ts", "generated/**/*.ts"]
}
